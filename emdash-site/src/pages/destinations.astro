---
import Base from "../layouts/Base.astro";
import PageIntro from "../components/PageIntro.astro";
import { entries, pageContent } from "../lib/cms";

const [page, visits] = await Promise.all([
	pageContent("destinations"),
	entries("destinations", { limit: 100, orderBy: { display_order: "asc" } }),
]);
---

<Base title={page?.title || "Places I've Visited"} description={page?.description}>
	<main class="min-h-screen px-4 pb-16 pt-20 sm:px-6 sm:pt-28 lg:px-8">
		<div class="container max-w-6xl space-y-8">
			<PageIntro section={page?.section || "Around the World"} title={page?.title || "Places I've Visited"} description={page?.description} body={page?.body} />
			<ol class="relative ml-2 max-w-4xl border-l border-[var(--line)]">
				{visits.map((visit) => <li class="relative grid grid-cols-[4.5rem_minmax(0,1fr)] gap-4 border-b border-[var(--line)]/70 py-6 pl-6 sm:grid-cols-[6rem_minmax(0,1fr)] sm:gap-8 sm:py-8 sm:pl-10">
					<span class="absolute -left-[6px] top-8 h-3 w-3 rounded-full bg-[var(--accent)] ring-4 ring-[var(--sand-1)] sm:top-10" aria-hidden="true"></span>
					{visit.data.year ? <time class="pt-1 font-mono text-lg font-semibold tabular-nums text-[var(--accent)] sm:text-2xl" datetime={visit.data.year}>{visit.data.label}</time> : <span class="pt-1 text-xs font-semibold text-[var(--accent)] sm:text-base">{visit.data.label}</span>}
					<div class="flex flex-wrap items-start gap-x-8 gap-y-4">{(visit.data.places || []).map((place: any) => <article><h2 class="text-xl font-semibold tracking-tight text-[var(--ink)] sm:text-2xl">{place.name}</h2>{place.cities && <p class="mt-1 text-sm text-[var(--muted)]">{place.cities}</p>}</article>)}</div>
				</li>)}
			</ol>
		</div>
	</main>
</Base>
