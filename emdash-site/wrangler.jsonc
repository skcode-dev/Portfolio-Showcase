{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "skcode",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "f45df256bb5141959104869ed872ea65",
		},
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "skcode-portfolio",
			"database_id": "57db5dcc-3ea7-460e-8d2b-b73bedcd69ae",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "skcode-portfolio-media",
		},
	],
	// Sandboxed plugins require Worker Loader, available on Workers paid plans. Uncomment to enable:
	// "worker_loaders": [{ "binding": "LOADER" }],
	// General maintenance cron trigger
	"triggers": {
		"crons": ["* * * * *"],
	},
}
